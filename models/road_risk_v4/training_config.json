    "rainfall_72h_mm",
    "rainfall_7d_mm",
    "temperature_c",
    "wind_speed_kmh",
    "upstream_rainfall_72h_mm",
    "catchment_mean_rainfall_72h_mm",
    "hand_m"
  ]
}